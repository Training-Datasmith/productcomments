  "license": "AFL-3.0",
  "require-dev": {
    "phpunit/phpunit": "7.5.20",
    "doctrine/orm": "2.9.3",
    "doctrine/dbal": "2.13.9",
    "doctrine/persistence": "2.2.4",
    "doctrine/doctrine-bundle": "2.2.4",
    "doctrine/annotations": "1.13.3",
    "symfony/framework-bundle": "4.4.51",
    "symfony/cache": "4.4.48"
